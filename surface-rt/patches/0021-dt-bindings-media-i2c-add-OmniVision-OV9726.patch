From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nuno407 <11352538+nuno407@users.noreply.github.com>
Date: Thu, 29 Oct 2026 11:43:18 +0000
Subject: [PATCH 21/45] dt-bindings: media: i2c: add OmniVision OV9726

Describe the OmniVision OV9726 1280x800 RAW10 1-lane MIPI CSI-2 sensor
used for both cameras of the Microsoft Surface RT.
---
 .../bindings/media/i2c/ovti,ov9726.yaml       | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml
new file mode 100644
index 000000000..2a7428f76
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov9726.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov9726.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV9726 Image Sensor
+
+description:
+  OmniVision OV9726 is a 1/6" 1280x800 colour RAW image sensor, controlled
+  over SCCB with 16-bit register addresses and transferring 10-bit RAW Bayer
+  data over a one-lane MIPI CSI-2 D-PHY interface.
+
+maintainers:
+  - nuno407 <11352538+nuno407@users.noreply.github.com>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov9726
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: XVCLK input clock, 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESETB pad of the sensor.
+    maxItems: 1
+
+  powerdown-gpios:
+    description: Active high GPIO connected to the PWDN pad of the sensor.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            maxItems: 1
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+      #include <dt-bindings/gpio/gpio.h>
+
+      i2c {
+          #address-cells = <1>;
+          #size-cells = <0>;
+
+          camera@10 {
+              compatible = "ovti,ov9726";
+              reg = <0x10>;
+              clocks = <&camera_clk 0>;
+              reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+              avdd-supply = <&vreg_2p8>;
+              dovdd-supply = <&vreg_1p8>;
+
+              port {
+                  endpoint {
+                      data-lanes = <1>;
+                      link-frequencies = /bits/ 64 <210000000>;
+                      remote-endpoint = <&csi_ep>;
+                  };
+              };
+          };
+      };
+...
-- 
