From: nuno407 <11352538+nuno407@users.noreply.github.com>
Date: Sat, 31 Oct 2026 01:10:56 +0000
Subject: [PATCH 41/45] ASoC: tegra30: ahub: read uncached registers from the
 hardware

The AHUB register maps use a flat cache with no defaults, so the first
read of a register that was never written returned a zero from the cache
and regmap warned "using zero-initialized flat cache". Use the sparse
flat cache: such a read goes to the hardware (every access is made with
the AHUB runtime-resumed), and a resume only syncs what was written.
---
 sound/soc/tegra/tegra30_ahub.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sound/soc/tegra/tegra30_ahub.c b/sound/soc/tegra/tegra30_ahub.c
index ee68f2885..1207d6069 100644
--- a/sound/soc/tegra/tegra30_ahub.c
+++ b/sound/soc/tegra/tegra30_ahub.c
@@ -466,7 +466,7 @@ static const struct regmap_config tegra30_ahub_apbif_regmap_config = {
 	.readable_reg = tegra30_ahub_apbif_wr_rd_reg,
 	.volatile_reg = tegra30_ahub_apbif_volatile_reg,
 	.precious_reg = tegra30_ahub_apbif_precious_reg,
-	.cache_type = REGCACHE_FLAT,
+	.cache_type = REGCACHE_FLAT_S,
 };
 
 static bool tegra30_ahub_ahub_wr_rd_reg(struct device *dev, unsigned int reg)
@@ -485,7 +485,7 @@ static const struct regmap_config tegra30_ahub_ahub_regmap_config = {
 	.max_register = LAST_REG(AUDIO_RX),
 	.writeable_reg = tegra30_ahub_ahub_wr_rd_reg,
 	.readable_reg = tegra30_ahub_ahub_wr_rd_reg,
-	.cache_type = REGCACHE_FLAT,
+	.cache_type = REGCACHE_FLAT_S,
 };
 
 static struct tegra30_ahub_soc_data soc_data_tegra30 = {
